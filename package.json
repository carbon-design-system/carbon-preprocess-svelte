{
  "name": "carbon-preprocess-svelte",
  "version": "0.11.46",
  "license": "Apache-2.0",
  "description": "Zero-dependency Svelte preprocessors and build plugins for the Carbon Design System",
  "author": "Eric Liu (https://github.com/metonym)",
  "type": "module",
  "bin": {
    "carbon-preprocess-svelte": "./dist/cli.js"
  },
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "scripts": {
    "index:components": "bun scripts/index-components.ts && biome check --write --unsafe src/component-index/index.ts",
    "prebuild": "bun run index:components",
    "build": "bun scripts/build.ts",
    "test": "rm -rf node_modules/.cache/carbon-preprocess-svelte && bun test --parallel",
    "test:e2e": "bun tests/test-e2e.ts",
    "test:e2e:update": "UPDATE_SNAPSHOTS=true bun tests/test-e2e.ts",
    "test:fixtures:update": "UPDATE_FIXTURES=true bun test tests/optimize-css-fixtures.test.ts",
    "bench": "ostia bench bench/optimize-css.bench.ts bench/optimize-imports.bench.ts bench/build-index.bench.ts",
    "typecheck": "tsc --noEmit",
    "lint": "biome ci --error-on-warnings",
    "lint:fix": "biome check --write --unsafe .",
    "upgrade-examples": "bun scripts/upgrade-examples.ts"
  },
  "devDependencies": {
    "@biomejs/biome": "2.5.14",
    "@types/bun": "^1.4.2",
    "@types/jest": "^30.0.0",
    "@typescript/typescript6": "^6.0.2",
    "carbon-components-svelte": "0.112.0",
    "carbon-components-svelte-old": "npm:carbon-components-svelte@0.85.0",
    "ostia": "^0.2.4",
    "postcss": "^8.5.28",
    "postcss-discard-empty": "^9.0.2",
    "svelte": "^5.57.0",
    "vite": "^8.3.0",
    "webpack": "^5.111.0"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/carbon-design-system/carbon-preprocess-svelte.git"
  },
  "homepage": "https://github.com/carbon-design-system/carbon-preprocess-svelte",
  "bugs": "https://github.com/carbon-design-system/carbon-preprocess-svelte/issues",
  "keywords": [
    "carbon",
    "carbon design system",
    "svelte",
    "preprocessor",
    "plugin",
    "zero-dependency",
    "optimize imports",
    "optimize CSS",
    "vite",
    "astro",
    "rollup",
    "rolldown",
    "webpack",
    "rspack"
  ],
  "files": [
    "dist"
  ],
  "maintainers": [
    "Eric Liu (https://github.com/metonym)"
  ]
}
