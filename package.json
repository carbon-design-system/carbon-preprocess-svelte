{
  "name": "carbon-preprocess-svelte",
  "version": "0.11.58",
  "license": "Apache-2.0",
  "description": "Zero-dependency Svelte preprocessors and build plugins for the Carbon Design System",
  "author": "Eric Liu (https://github.com/metonym)",
  "type": "module",
  "bin": {
    "carbon-preprocess-svelte": "./dist/cli.js"
  },
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "build": "bun scripts/build.ts",
    "test": "rm -rf node_modules/.cache/carbon-preprocess-svelte && bun test --parallel",
    "test:changed": "rm -rf node_modules/.cache/carbon-preprocess-svelte && bivium run --suite unit",
    "test:package": "bun scripts/test-package.ts",
    "test:e2e": "bun tests/test-e2e.ts",
    "test:e2e:update": "UPDATE_SNAPSHOTS=true bun tests/test-e2e.ts",
    "snapshots:from-ci": "bun scripts/snapshots-from-ci.ts",
    "test:fixtures:update": "UPDATE_FIXTURES=true bun test tests/optimize-css-fixtures.test.ts",
    "bench": "bun bench/run.ts",
    "typecheck": "bun check",
    "lint": "biome ci --error-on-warnings",
    "lint:fix": "biome check --write --unsafe .",
    "knip": "knip",
    "upgrade-examples": "bun scripts/upgrade-examples.ts",
    "eval:prop-aware": "bun scripts/eval-prop-aware.ts",
    "eval:specialize": "bun scripts/eval-specialize.ts",
    "eval:interactions": "bun scripts/eval-interactions.ts"
  },
  "devDependencies": {
    "@biomejs/biome": "2.6.3",
    "@types/bun": "^1.4.4",
    "@types/jest": "^30.0.0",
    "@typescript/typescript6": "^6.0.2",
    "bivium": "^0.2.0",
    "caligula": "^0.3.0",
    "carbon-components-svelte": "0.113.1",
    "carbon-components-svelte-old": "npm:carbon-components-svelte@0.85.0",
    "knip": "^6.43.0",
    "ostia": "^0.2.12",
    "playwright": "1.64.1",
    "severan": "^0.4.0",
    "sveast": "^0.9.6",
    "svelte": "^5.57.2",
    "vite": "^8.3.5",
    "webpack": "^5.112.2"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/carbon-design-system/carbon-preprocess-svelte.git"
  },
  "homepage": "https://github.com/carbon-design-system/carbon-preprocess-svelte",
  "bugs": "https://github.com/carbon-design-system/carbon-preprocess-svelte/issues",
  "keywords": [
    "carbon",
    "carbon design system",
    "svelte",
    "preprocessor",
    "plugin",
    "zero-dependency",
    "optimize imports",
    "optimize CSS",
    "vite",
    "astro",
    "rollup",
    "rolldown",
    "webpack",
    "rspack"
  ],
  "files": [
    "dist"
  ],
  "maintainers": [
    "Eric Liu (https://github.com/metonym)"
  ]
}
