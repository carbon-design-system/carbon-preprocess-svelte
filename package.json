{
  "name": "carbon-preprocess-svelte",
  "version": "0.14.4",
  "description": "Zero-dependency Svelte preprocessors and build plugins for the Carbon Design System",
  "license": "Apache-2.0",
  "author": "Eric Liu (https://github.com/metonym)",
  "repository": "github:carbon-design-system/carbon-preprocess-svelte",
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./package.json": "./package.json"
  },
  "bin": {
    "carbon-preprocess-svelte": "./dist/cli.js"
  },
  "files": [
    "dist"
  ],
  "engines": {
    "node": ">=22"
  },
  "keywords": [
    "carbon",
    "carbon design system",
    "svelte",
    "preprocessor",
    "plugin",
    "zero-dependency",
    "optimize imports",
    "optimize CSS",
    "vite",
    "astro",
    "rollup",
    "rolldown",
    "webpack",
    "rspack"
  ],
  "scripts": {
    "build": "bun scripts/build.ts",
    "test": "bun test --parallel",
    "test:changed": "bivium run --suite unit",
    "test:package": "bun scripts/test-package.ts",
    "test:e2e": "bun tests/test-e2e.ts",
    "test:e2e:update": "UPDATE_SNAPSHOTS=true bun tests/test-e2e.ts",
    "snapshots:from-ci": "bun scripts/snapshots-from-ci.ts",
    "bench": "bun bench/run.ts",
    "typecheck": "bun check",
    "typecheck:svelte": "svelte-typecheck --workspace golden --no-tsconfig --checker bun --diagnostic-sources js --fail-on-warnings",
    "lint:all": "bun fmt && bun lint --fix && svelte-lint --fix",
    "lint:changed": "bun fmt --staged && bun lint --staged --fix && svelte-lint --staged --fix",
    "lint:svelte": "svelte-lint",
    "knip": "knip",
    "upgrade-examples": "bun scripts/upgrade-examples.ts",
    "eval:prop-aware": "bun scripts/eval-prop-aware.ts",
    "eval:specialize": "bun scripts/eval-specialize.ts",
    "eval:interactions": "bun scripts/eval-interactions.ts"
  },
  "devDependencies": {
    "@types/bun": "^1.4.4",
    "@types/jest": "^30.0.0",
    "@typescript/typescript6": "^6.0.2",
    "bivium": "^0.4.0",
    "caligula": "^0.4.0",
    "carbon-components-svelte": "0.114.3",
    "carbon-components-svelte-old": "npm:carbon-components-svelte@0.85.0",
    "knip": "^6.43.0",
    "ostia": "^0.2.12",
    "playwright": "1.64.1",
    "svelte": "^5.57.2",
    "svelte-ast": "^0.12.0",
    "svelte-lint": "^0.4.0",
    "svelte-prune": "^0.15.3",
    "svelte-typecheck": "^0.4.0",
    "vite": "^8.3.5",
    "webpack": "^5.112.2"
  }
}
