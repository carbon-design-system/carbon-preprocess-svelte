{
  "$schema": "https://unpkg.com/knip@6/schema.json",
  "entry": [
    "src/index.ts",
    "src/browser.ts",
    "src/cli.ts",
    "src/optimize-components-loader.ts",
    "scripts/*.ts",
    "bench/*.ts",
    "tests/helpers/*.cjs",
    "bivium.config.ts"
  ],
  "project": [
    "src/**/*.ts",
    "scripts/**/*.ts",
    "bench/**/*.ts",
    "tests/**/*.{ts,cjs}"
  ],
  "ignoreDependencies": ["sveast", "prettier", "prettier-plugin-svelte"],
  "svelte": false
}
