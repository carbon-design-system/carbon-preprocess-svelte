{
  "compilerOptions": {
    "noEmit": true,
    "target": "ESNext",
    "module": "preserve",
    "strict": true,
    "erasableSyntaxOnly": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "skipLibCheck": true,
    "resolveJsonModule": true,
    "paths": {
      "carbon-preprocess-svelte": ["./src/index.ts"],
      "carbon-preprocess-svelte/*": ["./src/*"]
    },
    "types": ["jest"]
  },
  "include": ["bench", "scripts", "src", "tests"]
}
